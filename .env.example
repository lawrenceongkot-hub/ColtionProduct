# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# 1. Create a project
# 2. Go to APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add to Authorized JavaScript origins:
#    - http://localhost:5173 (development)
#    - https://coltionproduct.vercel.app (production)
# 5. Copy the Client ID and paste below
VITE_GOOGLE_CLIENT_ID=462641094828-ktc39kmvd696mq21esa7f899itrqfbo3.apps.googleusercontent.com

# Moxsys Payment Gateway (PRODUCTION)
# SECURITY: These secrets must live ONLY in the backend .env on the EC2 VPS.
# Do NOT commit real credentials. Do NOT expose the API key to the frontend.
# Get your production API key from: https://platform.moxsys.io
# Merchant: MPAY
MOXSYS_API_KEY=YOUR_PRODUCTION_MOXSYS_API_KEY
MOXSYS_MERCHANT_NAME=MPAY
MOXSYS_MODE=live

# Payment Gateway Mode
# live = real Moxsys API (requires MOXSYS_API_KEY set in backend .env)
PAYMENT_GATEWAY_MODE=live