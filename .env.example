z# Google OAuth Configuration
# Get your Client ID from: https://console.cloud.google.com/apis/credentials
# 1. Create a project
# 2. Go to APIs & Services → Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Add to Authorized JavaScript origins:
#    - http://localhost:5173 (development)
#    - https://coltionproduct.vercel.app (production)
# 5. Copy the Client ID and paste below
VITE_GOOGLE_CLIENT_ID=462641094828-ktc39kmvd696mq21esa7f899itrqfbo3.apps.googleusercontent.com

# Moxsys Payment Gateway
# Get your API key from: https://platform.moxsys.io
# Test key for development. Replace with LIVE key and mode=live for production.
MOXSYS_API_KEY=Ht23THehMXQmOa9QL91mkAKhmISIaTTATlzaVK43GghH4oW8IU
MOXSYS_MERCHANT_KEY=Letsgo
MOXSYS_MODE=sandbox

# Payment Gateway Mode
# simulated = local test gateway (default, no external API needed, auto-approves deposits)
# live = real Moxsys API (requires MOXSYS_API_KEY)
PAYMENT_GATEWAY_MODE=simulated
