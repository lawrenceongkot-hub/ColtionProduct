{
  "version": 2,
  "buildCommand": "npx prisma generate --schema=api/prisma/schema.prisma && vite build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.mjs"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}